# 复制为 .env 并改成你自己的随机 token：
#   openssl rand -hex 32  > 然后把结果填到下面
TIDO_TOKEN=replace-me-with-a-long-random-string

# 可选：host 暴露端口（默认 18080）
# TIDO_PORT=18080

# 可选：host 绑定地址（默认 127.0.0.1，仅本机可访问）
# 想让局域网其它机器直连可设 0.0.0.0；其它 docker 容器互通推荐用 mcp-net 共享网络，不要开 0.0.0.0
# TIDO_BIND=127.0.0.1

# 可选：覆盖镜像/容器版本标签
# VERSION=v0.1.0
